# Copiar a .env.local (nunca commitear ese archivo) y completar los valores
# reales. Agrupado por fase para que quede claro qué hace falta ahora y qué
# se conecta más adelante — ver docs/SPEC.md y el plan de acción.

# ── Fase 0 — Supabase (obligatorio desde ya) ────────────────────────
# Project Settings → API en el dashboard de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key: bypasea RLS. Server-only, nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Fase 2 — Cifrado de SSN/ITIN ─────────────────────────────────────
# Clave simétrica para lib/crypto/ssn.ts (AES-256-GCM). Generar con:
#   openssl rand -base64 32
SSN_ENCRYPTION_KEY=

# ── Fase 3 — Experian (consulta de score) ────────────────────────────
# Nombres de variable tentativos — ajustar una vez definido el producto/
# contrato real con Experian.
EXPERIAN_API_URL=
EXPERIAN_CLIENT_ID=
EXPERIAN_CLIENT_SECRET=

# ── Fase 4/6 — Stripe (mandato de cobro + cobranza automática) ──────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Fase 6 — Cron de cobranza diaria ─────────────────────────────────
# Vercel Cron manda este valor como Bearer token; el Route Handler del cron
# lo valida antes de hacer nada. Generar con: openssl rand -hex 32
CRON_SECRET=
